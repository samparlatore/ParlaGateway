<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
                             http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

    <display-name>ParlaGateway Health Reporter</display-name>

    <!-- Health Servlet -->
    <servlet>
        <servlet-name>HealthServlet</servlet-name>
        <servlet-class>com.parlAquatics.gateway.jetty.app.HealthServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>HealthServlet</servlet-name>
        <url-pattern>/health</url-pattern>
    </servlet-mapping>

    <!-- Metrics Servlet (optional) -->
    <servlet>
        <servlet-name>MetricsServlet</servlet-name>
        <servlet-class>com.parlAquatics.gateway.jetty.app.MetricsServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>MetricsServlet</servlet-name>
        <url-pattern>/metrics</url-pattern>
    </servlet-mapping>

    <!-- Status Servlet (optional) -->
    <servlet>
        <servlet-name>StatusServlet</servlet-name>
        <servlet-class>com.parlAquatics.gateway.jetty.app.StatusServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>StatusServlet</servlet-name>
        <url-pattern>/status</url-pattern>
    </servlet-mapping>

    <!-- Config Loader -->
    <listener>
        <listener-class>com.parlAquatics.gateway.jetty.cfg.ConfigLoader</listener-class>
    </listener>

</web-app>